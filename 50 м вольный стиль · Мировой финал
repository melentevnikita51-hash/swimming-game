<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>50 м вольный стиль · Мировой финал</title>
<style>
/* ══════════════════════════════════════════════════════════
   1. ПЕРЕМЕННЫЕ И БАЗА
   ══════════════════════════════════════════════════════════ */
:root{
  --bg-0:#030a12;
  --panel:rgba(8,24,40,.72);
  --line:rgba(120,190,255,.14);
  --line-hi:rgba(120,190,255,.32);
  --text:#ddebfa;
  --muted:#6d97ba;
  --accent:#37b6ff;
  --accent-2:#8ee6ff;
  --gold:#f6c945;
  --silver:#c9d5e6;
  --bronze:#cf8b4f;
  --green:#6fe79a;
  --mono:"JetBrains Mono","SF Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --sans:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--sans);
  color:var(--text);
  background:
    radial-gradient(1200px 620px at 50% -12%, #0d3152 0%, transparent 62%),
    radial-gradient(900px 520px at 92% 108%, #07203a 0%, transparent 60%),
    var(--bg-0);
  min-height:100vh;
  display:flex;
  justify-content:center;
  padding:22px 16px 46px;
  -webkit-font-smoothing:antialiased;
}
.app{width:100%;max-width:1160px;display:flex;flex-direction:column;gap:14px}

/* ══════════════════════════════════════════════════════════
   2. ШАПКА
   ══════════════════════════════════════════════════════════ */
.masthead{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap}
.eyebrow{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:5px}
h1{font-size:clamp(22px,3.6vw,34px);font-weight:900;line-height:1.04;letter-spacing:-.015em}
h1 em{font-style:normal;color:var(--accent)}
.wr-badge{
  display:inline-flex;align-items:center;gap:8px;
  font-family:var(--mono);font-size:12px;font-weight:600;color:var(--gold);
  border:1px solid rgba(246,201,69,.32);background:rgba(246,201,69,.07);
  border-radius:999px;padding:5px 13px;
}
.wr-badge b{font-size:9px;letter-spacing:.16em;color:rgba(246,201,69,.75);font-weight:800}

/* ══════════════════════════════════════════════════════════
   3. СЕТКА
   ══════════════════════════════════════════════════════════ */
.layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:start}
.board{display:flex;flex-direction:column;gap:10px;min-width:0}
@media (max-width:940px){ .layout{grid-template-columns:1fr} }

/* ══════════════════════════════════════════════════════════
   4. СЧЁТНОЕ ТАБЛО
   ══════════════════════════════════════════════════════════ */
.scorebar{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  background:linear-gradient(180deg,rgba(11,33,54,.92),rgba(7,22,38,.92));
  border:1px solid var(--line);border-radius:12px;padding:9px 14px;
}
.status{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pace{
  font-family:var(--mono);font-size:10.5px;color:var(--muted);
  border:1px solid var(--line);border-radius:999px;padding:2px 9px;white-space:nowrap;
  transition:color .2s,border-color .2s;
}
.pace.ahead{color:var(--green);border-color:rgba(111,231,154,.35)}
.clock{
  font-family:var(--mono);font-size:26px;font-weight:700;letter-spacing:.02em;
  color:var(--accent-2);font-variant-numeric:tabular-nums;
  min-width:96px;text-align:right;transition:color .2s;
}
.clock.go{color:var(--green)}

/* ══════════════════════════════════════════════════════════
   5. БАССЕЙН
   ══════════════════════════════════════════════════════════ */
.pool{
  position:relative;overflow:hidden;border-radius:16px;
  border:1px solid rgba(55,182,255,.24);
  background:linear-gradient(180deg,#0d5b96 0%,#0a4677 42%,#052a49 100%);
  box-shadow:0 26px 70px rgba(0,0,0,.65),inset 0 0 110px rgba(0,90,170,.45);
}
/* каустика на воде */
.pool::before{
  content:"";position:absolute;inset:-15%;pointer-events:none;opacity:.55;
  mix-blend-mode:screen;
  background:
    radial-gradient(ellipse 70px 20px at 20% 30%, rgba(255,255,255,.40), transparent 70%),
    radial-gradient(ellipse 90px 24px at 65% 62%, rgba(255,255,255,.28), transparent 70%),
    radial-gradient(ellipse 60px 18px at 42% 82%, rgba(255,255,255,.22), transparent 70%);
  background-size:260px 150px,340px 200px,220px 130px;
  animation:caustics 16s linear infinite;
}
@keyframes caustics{
  0%  {background-position:0 0, 140px 70px, 60px 100px}
  100%{background-position:260px 150px, -200px 270px, 280px -30px}
}
/* тёмная глубина снизу */
.pool::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg,rgba(0,0,0,0) 55%,rgba(0,10,20,.35) 100%);
}

/* ── дорожки ── */
.lanes{position:relative;z-index:2;padding:6px 0}
.lane{
  position:relative;height:46px;display:flex;align-items:center;
  border-bottom:1px solid rgba(140,210,255,.09);
  transition:background .25s;
}
.lane:last-child{border-bottom:0}
.lane::after{
  content:"";position:absolute;left:0;right:0;top:50%;height:1px;pointer-events:none;
  background:linear-gradient(90deg,transparent 8%,rgba(180,230,255,.10) 30%,rgba(180,230,255,.10) 70%,transparent 92%);
}
.lane.lead{background:linear-gradient(90deg,rgba(246,201,69,.13),rgba(246,201,69,0) 55%)}

.lane-no{
  position:absolute;left:8px;top:50%;transform:translateY(-50%);
  font-family:var(--mono);font-size:9.5px;font-weight:700;
  color:rgba(160,215,255,.32);z-index:6;
}
.lane-rank{
  position:absolute;left:24px;top:50%;transform:translateY(-50%);
  font-family:var(--mono);font-size:10px;font-weight:800;
  color:var(--muted);z-index:6;
}
.lane-tag{
  position:absolute;right:50px;top:50%;transform:translateY(-50%);
  font-size:9.5px;letter-spacing:.09em;font-weight:700;
  color:rgba(190,225,255,.26);z-index:6;white-space:nowrap;
}
.lane-time{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  font-family:var(--mono);font-size:11px;font-weight:600;
  color:var(--accent-2);opacity:0;transition:opacity .25s;z-index:6;
}
.lane-time.show{opacity:.95}

/* ── стартовая тумба ── */
.start-block{
  position:absolute;left:9%;top:4px;width:30px;height:8px;
  transform:translateX(-50%);border-radius:2px;z-index:1;
  background:linear-gradient(180deg,#a8bccd,#63788b);
  box-shadow:0 2px 0 rgba(16,36,54,.8),0 4px 10px rgba(0,0,0,.4);
}
.start-block::before{
  content:"";position:absolute;left:50%;top:-3px;width:12px;height:3px;
  transform:translateX(-50%);border-radius:1px;background:#cfe0ee;
}
.start-block::after{
  content:"";position:absolute;left:-7px;top:5px;width:7px;height:2px;
  background:rgba(200,225,245,.5);
}

/* ── финишный створ ── */
.rope{
  position:absolute;right:9%;top:0;bottom:0;width:5px;z-index:3;border-radius:2px;
  background:repeating-linear-gradient(180deg,#fff 0 6px,#e33 6px 12px);
  opacity:.5;
}

/* ── пловец ── */
.swimmer{
  position:absolute;top:50%;left:9%;width:64px;height:38px;z-index:4;
  transform:translate(-50%,-50%);will-change:left,transform;pointer-events:none;
}
.swimmer .fig{width:100%;height:100%;transform-origin:50% 60%;will-change:transform}
.swimmer svg{width:100%;height:100%;overflow:visible;filter:drop-shadow(0 3px 6px rgba(0,0,0,.55))}
.swimmer.done{opacity:.5;filter:saturate(.65)}

/* ── fx-слой и вспышка ── */
.pool-fx{position:absolute;inset:0;z-index:5;pointer-events:none}
.pool-flash{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:clamp(52px,11vw,96px);font-weight:800;letter-spacing:.04em;
  color:rgba(255,255,255,.94);text-shadow:0 0 46px rgba(120,220,255,.85);
  opacity:0;transform:scale(.9);pointer-events:none;z-index:7;
  transition:opacity .18s ease,transform .3s ease;
}
.pool-flash.show{opacity:1;transform:scale(1)}
.pool-flash.go{color:#a8ffc4;text-shadow:0 0 54px rgba(110,255,160,.9)}

/* ══════════════════════════════════════════════════════════
   6. КНОПКИ
   ══════════════════════════════════════════════════════════ */
.controls{display:flex;gap:9px;flex-wrap:wrap;align-items:center}
.btn{
  font:inherit;font-size:13px;font-weight:800;letter-spacing:.06em;
  border:none;border-radius:9px;padding:11px 24px;cursor:pointer;
  transition:transform .12s,box-shadow .12s,filter .12s,background .12s;
}
.btn-primary{background:linear-gradient(180deg,#5cc8ff,#1f9fe0);color:#04121e;box-shadow:0 8px 22px rgba(56,182,255,.32)}
.btn-primary:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 12px 28px rgba(56,182,255,.42)}
.btn-ghost{background:rgba(255,255,255,.06);color:#a8c8e2;border:1px solid rgba(143,227,255,.16);padding:11px 16px}
.btn-ghost:hover:not(:disabled){background:rgba(255,255,255,.12)}
.btn:disabled{filter:grayscale(.7) brightness(.65);cursor:not-allowed}
.hint{font-size:10.5px;color:var(--muted);letter-spacing:.02em}

/* ══════════════════════════════════════════════════════════
   7. ПАНЕЛЬ УЧАСТНИКОВ
   ══════════════════════════════════════════════════════════ */
.roster{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:11px;min-width:0}
.roster-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.roster h2{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);font-weight:800}
.roster .cnt{font-family:var(--mono);font-size:9.5px;color:rgba(120,190,255,.45)}
.cards{display:grid;grid-template-columns:1fr;gap:5px}
.card{
  display:grid;grid-template-columns:18px 38px minmax(0,1fr) auto;gap:8px;align-items:center;
  padding:5px 8px;border:1px solid rgba(120,190,255,.10);border-radius:10px;
  background:rgba(255,255,255,.03);
  transition:border-color .25s,background .25s,transform .25s;
}
.card.lead{
  border-color:rgba(246,201,69,.5);
  background:linear-gradient(90deg,rgba(246,201,69,.13),rgba(246,201,69,.02));
  transform:translateX(-2px);
}
.card .chip{
  font-family:var(--mono);font-size:10px;font-weight:800;text-align:center;
  color:var(--accent-2);
}
.card.lead .chip{color:var(--gold)}
.ava svg{width:38px;height:38px;display:block;border-radius:50%}
.meta{min-width:0}
.nm{font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ct{font-size:9.5px;color:var(--muted);letter-spacing:.03em;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.delta{font-family:var(--mono);font-size:10px;color:var(--accent-2);white-space:nowrap;text-align:right}
@media (max-width:940px){ .cards{grid-template-columns:1fr 1fr} }
@media (max-width:460px){ .cards{grid-template-columns:1fr} }

/* ══════════════════════════════════════════════════════════
   8. ПРОТОКОЛ
   ══════════════════════════════════════════════════════════ */
.results{
  width:100%;padding:16px 18px;background:rgba(7,26,44,.85);
  border:1px solid var(--line);border-radius:14px;
  opacity:0;transform:translateY(10px);pointer-events:none;
  transition:opacity .35s ease,transform .35s ease;
}
.results.show{opacity:1;transform:none;pointer-events:auto}
.results h2{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:12px;font-weight:800}
table{width:100%;border-collapse:collapse;font-size:13px}
th{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;text-align:right;padding:4px 7px;white-space:nowrap}
td{padding:6px 7px;text-align:right;font-variant-numeric:tabular-nums;border-top:1px solid rgba(143,227,255,.08)}
th.l,td.l{text-align:left}
tr.p1 td{background:rgba(246,201,69,.10)}
tr.p2 td{background:rgba(200,211,227,.06)}
tr.p3 td{background:rgba(207,139,79,.07)}
.t{font-family:var(--mono);font-weight:700;color:var(--accent-2)}
.m{font-family:var(--mono);color:var(--muted);font-size:12px}
.diff{font-size:11px;color:var(--muted);font-family:var(--mono)}
.badge{font-size:9px;font-weight:800;border-radius:4px;padding:1px 4px;margin-left:5px;vertical-align:1px}
.badge.wr{color:var(--gold);background:rgba(246,201,69,.16)}
.badge.pb{color:var(--green);background:rgba(111,231,154,.14)}
@media (max-width:760px){
  .splits{display:none}
  .lane{height:38px}
  .swimmer{width:50px;height:30px}
  .clock{font-size:21px;min-width:76px}
  .pace,.hint{display:none}
  .lane-tag{display:none}
}

/* ══════════════════════════════════════════════════════════
   9. КОНФЕТТИ И ФУТЕР
   ══════════════════════════════════════════════════════════ */
.confetti{position:fixed;inset:0;z-index:90;pointer-events:none}
footer{text-align:center;font-size:10.5px;color:rgba(109,151,186,.65);letter-spacing:.04em}
</style>
</head>
<body>

<div class="app">

  <header class="masthead">
    <div>
      <div class="eyebrow">Мировой финал · 8 сильнейших</div>
      <h1>50 м <em>вольный стиль</em></h1>
    </div>
    <div class="wr-badge"><b>МК</b> 20.91</div>
  </header>

  <main class="layout">
    <section class="board">
      <div class="scorebar">
        <span class="status" id="status">Готовы к старту</span>
        <span class="pace" id="pace">МР 20.91</span>
        <span class="clock" id="clock" aria-live="off">0.00</span>
      </div>

      <div class="pool" id="pool">
        <div class="rope" aria-hidden="true"></div>
        <div class="lanes" id="lanes"></div>
        <canvas class="pool-fx" id="poolFx" aria-hidden="true"></canvas>
        <div class="pool-flash" id="poolFlash" aria-hidden="true"></div>
      </div>

      <div class="controls">
        <button class="btn btn-primary" id="start">СТАРТ</button>
        <button class="btn btn-ghost" id="reset">СБРОС</button>
        <button class="btn btn-ghost" id="sound" aria-pressed="true" title="Звук (M)">🔊</button>
        <span class="hint">Пробел — старт · R — сброс · M — звук</span>
      </div>
    </section>

    <aside class="roster">
      <div class="roster-head">
        <h2>Топ-8 мира</h2>
        <span class="cnt">LIVE</span>
      </div>
      <div class="cards" id="cards"></div>
    </aside>
  </main>

  <section class="results" id="results" aria-live="polite">
    <h2 id="resTitle">Итоговый протокол</h2>
    <div id="table"></div>
  </section>

  <footer>Симуляция · личные рекорды приближены к реальным · 8 дорожек</footer>
</div>

<canvas class="confetti" id="confetti" aria-hidden="true"></canvas>
<noscript>Для запуска игры включите JavaScript.</noscript>

<script>
(() => {
'use strict';

/* ══════════════════════════════════════════════════════════
   1. КОНФИГУРАЦИЯ
   ══════════════════════════════════════════════════════════ */
const CFG = {
  DIST:       50,     // дистанция, м
  WR:         20.91,  // мировой рекорд, с
  WR_REACT:   0.61,   // реакция автора МР
  PLAYBACK:   1.85,   // ускорение показа (1 = реальные секунды)
  COUNTDOWN:  780,    // пауза между сигналами старта, мс
  LANE_LEFT:  9,      // старт, % ширины дорожки
  LANE_RIGHT: 88,     // финиш, % ширины дорожки
  DIVE:       0.60    // длительность прыжка в «соревновательных» секундах
};

// порядок жеребьёвки: 1-й сеет 4-ю дорожку, 2-й — 5-ю и т.д.
const LANE_ORDER = [4, 5, 3, 6, 2, 7, 1, 8];

// Топ-8 спринтеров на 50 м вольным стилем (ПР условные, близкие к реальным)
const ROSTER = [
  { name:'К. Дрессел',   flag:'🇺🇸', c:'USA', pb:21.04, color:'#4dabf7' },
  { name:'К. МакЭвой',   flag:'🇦🇺', c:'AUS', pb:21.06, color:'#ffd166' },
  { name:'Б. Прауд',     flag:'🇬🇧', c:'GBR', pb:21.11, color:'#ff8787' },
  { name:'Ф. Манаду',    flag:'🇫🇷', c:'FRA', pb:21.19, color:'#63e6be' },
  { name:'Дж. Лиендо',   flag:'🇨🇦', c:'CAN', pb:21.26, color:'#f783ac' },
  { name:'К. Гкомолеев', flag:'🇬🇷', c:'GRE', pb:21.44, color:'#a9e34b' },
  { name:'Дж. Крукс',    flag:'🇰🇾', c:'CAY', pb:21.51, color:'#b197fc' },
  { name:'С. Сабо',      flag:'🇭🇺', c:'HUN', pb:21.86, color:'#ffa94d' }
];

/* ══════════════════════════════════════════════════════════
   2. DOM
   ══════════════════════════════════════════════════════════ */
const $ = id => document.getElementById(id);
const poolEl    = $('pool');
const lanesEl   = $('lanes');
const cardsEl   = $('cards');
const clockEl   = $('clock');
const statusEl  = $('status');
const paceEl    = $('pace');
const startBtn  = $('start');
const resetBtn  = $('reset');
const soundBtn  = $('sound');
const resultsEl = $('results');
const tableEl   = $('table');
const titleEl   = $('resTitle');
const flashEl   = $('poolFlash');
const fxCanvas  = $('poolFx');
const fxCtx     = fxCanvas.getContext('2d');
const confettiEl= $('confetti');
const confettiCtx = confettiEl.getContext('2d');

/* ══════════════════════════════════════════════════════════
   3. МАТЕМАТИКА ТЕМПА
   Скорость спринтера: v(u) = (1 - e^(-u/a)) · (1 - b·u^p)
   Интеграл нормируется к 1 — значение = доля дистанции.
   ══════════════════════════════════════════════════════════ */
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;

function buildCurve(a, b, p, N = 180) {
  const vel = u => (1 - Math.exp(-u / a)) * (1 - b * Math.pow(u, p));
  const cum = new Float64Array(N + 1);
  for (let i = 1; i <= N; i++) {
    const x0 = (i - 1) / N, x1 = i / N;
    cum[i] = cum[i - 1] + (vel(x0) + vel(x1)) / 2 / N;
  }
  const total = cum[N];
  for (let i = 0; i <= N; i++) cum[i] /= total;
  return cum;
}

function curveAt(c, u) {
  if (u <= 0) return 0;
  if (u >= 1) return 1;
  const N = c.length - 1, x = u * N, i = x | 0, f = x - i;
  return c[i] + (c[i + 1] - c[i]) * f;
}

function fracToTime(c, frac) {
  if (frac <= 0) return 0;
  if (frac >= 1) return 1;
  const N = c.length - 1;
  let lo = 0, hi = N;
  while (lo < hi) {
    const mid = (lo + hi) >> 1;
    if (c[mid] < frac) lo = mid + 1; else hi = mid;
  }
  const i = Math.max(1, lo);
  const A = c[i - 1], B = c[i];
  const f = B === A ? 0 : (frac - A) / (B - A);
  return (i - 1 + f) / N;
}

const WR_CURVE = buildCurve(0.072, 0.105, 1.75);

/* ══════════════════════════════════════════════════════════
   4. SVG: ПЛОВЕЦ И ПОРТРЕТ
   ══════════════════════════════════════════════════════════ */
function swimmerSVG(color) {
  return `<svg viewBox="0 0 68 40" preserveAspectRatio="xMidYMid meet"
               aria-hidden="true" focusable="false">
    <ellipse cx="9" cy="25" rx="15" ry="4" fill="#fff" opacity=".09"/>
    <g class="a-back">
      <line x1="41" y1="21" x2="27" y2="21" stroke="${color}"
            stroke-width="3" stroke-linecap="round" opacity=".55"/>
    </g>
    <g class="leg-a"><line x1="18" y1="18" x2="5" y2="18" stroke="${color}"
            stroke-width="3" stroke-linecap="round"/></g>
    <g class="leg-b"><line x1="18" y1="22" x2="5" y2="22" stroke="${color}"
            stroke-width="3" stroke-linecap="round"/></g>
    <rect x="16" y="15" width="34" height="10" rx="5" fill="${color}"/>
    <circle cx="55" cy="20" r="6.4" fill="${color}"/>
