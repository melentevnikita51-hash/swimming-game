/* позы конечностей */
function poseBlock(fig) {
  fig.armF.setAttribute('transform', 'rotate(-38 45 19)');
  fig.armB.setAttribute('transform', 'rotate(-32 41 21)');
  fig.legA.setAttribute('transform', 'rotate(10 18 18)');
  fig.legB.setAttribute('transform', 'rotate(-9 18 22)');
}
function poseDive(fig) {
  fig.armF.setAttribute('transform', 'rotate(4 45 19)');
  fig.armB.setAttribute('transform', 'rotate(2 41 21)');
  fig.legA.setAttribute('transform', 'rotate(-2 18 18)');
  fig.legB.setAttribute('transform', 'rotate(2 18 22)');
}
function poseFinish(fig) {
  fig.armF.setAttribute('transform', 'rotate(-6 45 19)');
  fig.armB.setAttribute('transform', 'rotate(-4 41 21)');
  fig.legA.setAttribute('transform', 'rotate(6 18 18)');
  fig.legB.setAttribute('transform', 'rotate(-4 18 22)');
}
function animateFigure(fig, phase) {
  const a = Math.sin(phase * Math.PI * 2);
  const b = Math.sin(phase * Math.PI * 2 + Math.PI);
  fig.armF.setAttribute('transform', `rotate(${(a * 30).toFixed(1)} 45 19)`);
  fig.armB.setAttribute('transform', `rotate(${(b * 26).toFixed(1)} 41 21)`);
  fig.legA.setAttribute('transform', `rotate(${(b * 16).toFixed(1)} 18 18)`);
  fig.legB.setAttribute('transform', `rotate(${(a * 16).toFixed(1)} 18 22)`);
}

/* ══════════════════════════════════════════════════════════
   5. СОСТОЯНИЕ
   ══════════════════════════════════════════════════════════ */
const state = {
  lanes: [],
  entries: [],
  cards: new Map(),
  running: false,
  counting: false,
  t0: 0,
  raf: 0,
  timers: [],
  flashTimer: 0,
  wrCurve: WR_CURVE
};

/* ══════════════════════════════════════════════════════════
   6. ПОСТРОЕНИЕ ДОРОЖЕК И КАРТОЧЕК
   ══════════════════════════════════════════════════════════ */
function buildLanes() {
  lanesEl.innerHTML = '';

  const seeded = ROSTER
    .slice()
    .sort((a, b) => a.pb - b.pb)
    .map((s, i) => ({ ...s, lane: LANE_ORDER[i] }))
    .sort((a, b) => a.lane - b.lane);

  state.lanes = seeded.map(seed => {
    const laneEl = document.createElement('div');
    laneEl.className = 'lane';
    laneEl.innerHTML = `
      <span class="lane-no">${seed.lane}</span>
      <span class="lane-rank"></span>
      <div class="start-block" aria-hidden="true"></div>
      <span class="lane-tag">${seed.flag} ${seed.c}</span>
      <div class="swimmer"><div class="fig">${swimmerSVG(seed.color)}</div></div>
      <span class="lane-time"></span>`;
    lanesEl.appendChild(laneEl);

    const wrap  = laneEl.querySelector('.swimmer');
    const figEl = wrap.querySelector('.fig');

    return {
      seed, el: laneEl, wrap, figEl,
      rankEl: laneEl.querySelector('.lane-rank'),
      timeEl: laneEl.querySelector('.lane-time'),
      fig: {
        armF: wrap.querySelector('.a-front'),
        armB: wrap.querySelector('.a-back'),
        legA: wrap.querySelector('.leg-a'),
        legB: wrap.querySelector('.leg-b')
      }
    };
  });
}

function buildCards() {
  cardsEl.innerHTML = '';
  state.cards.clear();

  ROSTER.forEach((s, i) => {
    const card = document.createElement('article');
    card.className = 'card';
    card.innerHTML = `
      <span class="chip">–</span>
      <div class="ava">${portraitSVG(s.color, i)}</div>
      <div class="meta">
        <div class="nm">${s.flag} ${s.name}</div>
        <div class="ct">${s.c} · PB ${s.pb.toFixed(2)}</div>
      </div>
      <div class="delta"></div>`;
    cardsEl.appendChild(card);

    state.cards.set(s.name, {
      el: card,
      chip: card.querySelector('.chip'),
      delta: card.querySelector('.delta')
    });
  });
}

/* ══════════════════════════════════════════════════════════
   7. ЗВУК
   ══════════════════════════════════════════════════════════ */
let audioCtx = null;
let muted = false;

function beep(freq, dur, type, gain) {
  if (muted) return;
  try {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    if (!audioCtx) audioCtx = new Ctx();
    const osc = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    osc.type = type || 'sine';
    osc.frequency.value = freq;
    const t = audioCtx.currentTime;
    g.gain.setValueAtTime(gain || 0.06, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    osc.connect(g);
    g.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + dur + 0.02);
  } catch (e) { /* звук не критичен */ }
}

/* ══════════════════════════════════════════════════════════
   8. ЧАСТИЦЫ НА ВОДЕ
   ══════════════════════════════════════════════════════════ */
const fx = { w: 0, h: 0, parts: [], ripples: [], raf: 0, running: false };

function fxResize() {
  const r = poolEl.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  fx.w = r.width;
  fx.h = r.height;
  fxCanvas.width  = Math.max(1, Math.round(r.width  * dpr));
  fxCanvas.height = Math.max(1, Math.round(r.height * dpr));
  fxCanvas.style.width  = r.width  + 'px';
  fxCanvas.style.height = r.height + 'px';
  fxCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function lanePoint(e) {
  // координаты центра пловца в пикселях относительно пула
  const x = e.el.offsetLeft + e.el.offsetWidth * (e.xPct || CFG.LANE_LEFT) / 100;
  const y = e.el.offsetTop + e.el.offsetHeight / 2 + 6;
  return { x, y };
}

function spawnSplash(x, y, n, power) {
  for (let i = 0; i < n; i++) {
    const ang = -Math.PI / 2 + (Math.random() - 0.5) * 2.2;
    const sp = (0.7 + Math.random() * 1.7) * power;
    fx.parts.push({
      x, y,
      vx: Math.cos(ang) * sp * 2.3,
      vy: Math.sin(ang) * sp * 2.7,
      r: 0.8 + Math.random() * 2.2,
      life: 1,
      decay: 0.012 + Math.random() * 0.014,
      c: Math.random() < 0.5 ? '#e6f7ff' : '#9fd8ff'
    });
  }
  fx.ripples.push({ x, y, r: 2, max: 22 + Math.random() * 18, life: 1 });
  kickFx();
}

function kickFx() {
  if (fx.running) return;
  fx.running = true;
  fx.raf = requestAnimationFrame(fxStep);
}

function fxStep() {
  fxCtx.clearRect(0, 0, fx.w, fx.h);

  // круги на воде
  for (let i = fx.ripples.length - 1; i >= 0; i--) {
    const r = fx.ripples[i];
    r.r += (r.max - r.r) * 0.07;
    r.life -= 0.02;
    if (r.life <= 0) { fx.ripples.splice(i, 1); continue; }
    fxCtx.beginPath();
    fxCtx.ellipse(r.x, r.y, r.r, r.r * 0.32, 0, 0, Math.PI * 2);
    fxCtx.strokeStyle = `rgba(190,235,255,${(r.life * 0.30).toFixed(3)})`;
    fxCtx.lineWidth = 1.2;
    fxCtx.stroke();
  }

  // брызги
  for (let i = fx.parts.length - 1; i >= 0; i--) {
    const p = fx.parts[i];
    p.vy += 0.22;
    p.x += p.vx;
    p.y += p.vy;
    p.life -= p.decay;
    if (p.life <= 0 || p.y > fx.h + 10) { fx.parts.splice(i, 1); continue; }
    fxCtx.globalAlpha = Math.min(1, p.life);
    fxCtx.fillStyle = p.c;
    fxCtx.beginPath();
    fxCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    fxCtx.fill();
  }
  fxCtx.globalAlpha = 1;

  if (fx.parts.length || fx.ripples.length) {
    fx.raf = requestAnimationFrame(fxStep);
  } else {
    fx.running = false;
  }
}

/* ══════════════════════════════════════════════════════════
   9. ГЕНЕРАЦИЯ ЗАПЛЫВА
   ══════════════════════════════════════════════════════════ */
function makeEntry(lane) {
  const s = lane.seed;

  // 12% заплывов — «идеальные», почти повторение личного рекорда
  const perfect = Math.random() < 0.12;
  const penalty = perfect ? Math.random() * 0.04 : 0.06 + Math.random() * 0.30;
  const luck = ((Math.random() + Math.random() + Math.random()) / 3 - 0.5) * 0.16;
  const time = Math.max(CFG.WR - 0.10, s.pb + penalty + luck);

  const reaction = 0.55 + Math.random() * 0.20;
  const curve = buildCurve(
    0.055 + Math.random() * 0.040,   // резкость разгона
    0.070 + Math.random() * 0.100,   // сила затухания
    1.45  + Math.random() * 0.700    // форма усталости
  );

  return {
    ...lane,
    time, reaction, curve,
    dist: 0, xPct: CFG.LANE_LEFT,
    done: false, place: 0,
    phase: Math.random(),
    splashed: false
  };
}

/* ══════════════════════════════════════════════════════════
   10. СБРОС СЦЕНЫ
   ══════════════════════════════════════════════════════════ */
function clearTimers() {
  state.timers.forEach(clearTimeout);
  state.timers = [];
}

function resetScene() {
  for (const l of state.lanes) {
    l.wrap.style.left = CFG.LANE_LEFT + '%';
    l.wrap.style.transform = 'translate(-50%, calc(-50% - 16px))';
    l.figEl.style.transform = 'rotate(0deg)';
    l.wrap.classList.remove('done');
    l.timeEl.textContent = '';
    l.timeEl.classList.remove('show');
    l.rankEl.textContent = '';
    l.el.classList.remove('lead');
    poseBlock(l.fig);
  }
  for (const c of state.cards.values()) {
    c.chip.textContent = '–';
    c.delta.textContent = '';
    c.el.classList.remove('lead');
  }
  paceEl.textContent = 'МР ' + CFG.WR.toFixed(2);
  paceEl.classList.remove('ahead');
}

function flash(text, kind) {
  flashEl.textContent = text;
  flashEl.className = 'pool-flash show' + (kind === 'go' ? ' go' : '');
  clearTimeout(state.flashTimer);
  state.flashTimer = setTimeout(() => {
    flashEl.classList.remove('show');
  }, kind === 'go' ? 560 : 420);
}

/* ══════════════════════════════════════════════════════════
   11. СТАРТ
   ══════════════════════════════════════════════════════════ */
function startRace() {
  if (state.running || state.counting) return;

  clearTimers();
  cancelAnimationFrame(state.raf);
  stopConfetti();

  resultsEl.classList.remove('show');
  tableEl.innerHTML = '';
  titleEl.textContent = 'Итоговый протокол';
  resetScene();
  fxResize();

  startBtn.disabled = true;
  startBtn.textContent = 'ЗАПЛЫВ…';
  statusEl.textContent = 'На старте';
  clockEl.classList.remove('go');

  state.entries = state.lanes.map(makeEntry);
  state.counting = true;
  countdown(3);
}

function countdown(n) {
  if (n > 0) {
    clockEl.textContent = String(n);
    statusEl.textContent = 'На старте';
    flash(String(n), 'num');
    beep(470, 0.10, 'sine', 0.05);
    state.timers.push(setTimeout(() => countdown(n - 1), CFG.COUNTDOWN));
  } else {
    clockEl.textContent = 'GO';
    clockEl.classList.add('go');
    statusEl.textContent = 'Заплыв идёт';
    flash('GO', 'go');
    beep(900, 0.20, 'sine', 0.07);
    begin();
  }
}

function begin() {
  state.counting = false;
  state.running = true;
  state.t0 = performance.now();
  clockEl.textContent = '0.00';
  clockEl.classList.remove('go');
  state.raf = requestAnimationFrame(loop);
}

/* ══════════════════════════════════════════════════════════
   12. ИГРОВОЙ ЦИКЛ
   ══════════════════════════════════════════════════════════ */
function loop(now) {
  if (!state.running) return;

  const rt = ((now - state.t0) / 1000) * CFG.PLAYBACK;
  let maxT = 0;

  for (const e of state.entries) {
    if (e.time > maxT) maxT = e.time;

    const T = e.time, R = e.reaction;
    const u = clamp((rt - R) / (T - R), 0, 1);
    e.dist = CFG.DIST * curveAt(e.curve, u);
    e.xPct = CFG.LANE_LEFT + (e.dist / CFG.DIST) * (CFG.LANE_RIGHT - CFG.LANE_LEFT);

    let y = 0, rot = 0;
    if (rt < R) {
      y = -16;
      poseBlock(e.fig);
    } else {
      const k = clamp((rt - R) / CFG.DIVE, 0, 1);
      y = -16 * (1 - k) - 7 * Math.sin(Math.PI * k);
      rot = 14 * Math.sin(Math.PI * k);

      if (k < 1) {
        poseDive(e.fig);
      } else if (u < 1) {
        e.phase = (e.phase + 0.075) % 1;
        animateFigure(e.fig, e.phase);
      } else {
        poseFinish(e.fig);
      }

      if (k >= 1 && !e.splashed) {
        e.splashed = true;
        const p = lanePoint(e);
        spawnSplash(p.x, p.y, 16, 1.0);
      }
    }

    e.wrap.style.left = e.xPct.toFixed(2) + '%';
    e.wrap.style.transform =
      `translate(-50%, calc(-50% + ${y.toFixed(1)}px))`;
    e.figEl.style.transform = `rotate(${rot.toFixed(1)}deg)`;

    if (u >= 1 && !e.done) {
      e.done = true;
      e.wrap.classList.add('done');
      e.timeEl.textContent = e.time.toFixed(2);
      e.timeEl.classList.add('show');
      const p = lanePoint(e);
      spawnSplash(p.x, p.y, 10, 0.75);
      beep(720, 0.05, 'triangle', 0.04);
    }
  }

  /* живые места */
  const order = state.entries.slice().sort((a, b) => {
    if (a.done !== b.done) return a.done ? -1 : 1;
    if (a.done) return a.time - b.time;
    return b.dist - a.dist;
  });
  const lead = order[0];

  order.forEach((e, i) => {
    const p = i + 1;
    if (e.place !== p) {
      e.place = p;
      e.rankEl.textContent = p;
      const c = state.cards.get(e.seed.name);
      if (c) c.chip.textContent = p;
    }
    e.el.classList.toggle('lead', p === 1);
    const c = state.cards.get(e.seed.name);
    if (c) c.el.classList.toggle('lead', p === 1);
  });

  /* отставание в метрах на карточках */
  for (const e of state.entries) {
    const c = state.cards.get(e.seed.name);
    if (!c) continue;
    if (e.done) {
      c.delta.textContent = e.time.toFixed(2);
    } else if (lead && lead !== e && lead.dist > 0.02) {
      c.delta.textContent = '−' + (lead.dist - e.dist).toFixed(1) + ' м';
    } else {
      c.delta.textContent = '';
    }
  }

  /* такт мирового рекорда */
  if (rt < CFG.WR) {
    const wrU = clamp((rt - CFG.WR_REACT) / (CFG.WR - CFG.WR_REACT), 0, 1);
    const wrDist = CFG.DIST * curveAt(WR_CURVE, wrU);
    const gap = lead.dist - wrDist;
    paceEl.textContent = (gap >= 0 ? '+' : '−') + Math.abs(gap).toFixed(1) + ' м к МР';
    paceEl.classList.toggle('ahead', gap >= 0);
  } else {
    paceEl.textContent = 'темп МР пройден';
    paceEl.classList.remove('ahead');
  }

  clockEl.textContent = rt.toFixed(2);

  if (rt > maxT + 0.9) { finishRace(); return; }
  state.raf = requestAnimationFrame(loop);
}

/* ══════════════════════════════════════════════════════════
   13. ФИНИШ И ПРОТОКОЛ
   ══════════════════════════════════════════════════════════ */
function finishRace() {
  cancelAnimationFrame(state.raf);
  state.running = false;
  startBtn.disabled = false;
  startBtn.textContent = 'ЕЩЁ РАЗ';
  statusEl.textContent = 'Финиш';
  clockEl.classList.remove('go');

  const sorted = state.entries.slice().sort((a, b) => a.time - b.time);
  clockEl.textContent = sorted[0].time.toFixed(2);

  const photo = sorted.length > 1 && (sorted[1].time - sorted[0].time) < 0.01;
  titleEl.textContent = photo
    ? 'Итоговый протокол · фотофиниш'
    : 'Итоговый протокол';

  buildResults(sorted);
  resultsEl.classList.add('show');
  resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  beep(880, 0.16, 'sine', 0.06);
  state.timers.push(setTimeout(() => beep(1320, 0.26, 'sine', 0.06), 150));

  if (sorted[0].time <= CFG.WR) {
    state.timers.push(setTimeout(startConfetti, 320));
  }
}

function buildResults(sorted) {
  const winner = sorted[0].time;
  const medals = ['🥇', '🥈', '🥉'];

  const splitTime = (e, metres) =>
    e.reaction + (e.time - e.reaction) * fracToTime(e.curve, metres / CFG.DIST);

  const rows = sorted.map((e, i) => {
    const place = i + 1;
    const cls = place <= 3 ? 'p' + place : '';
    const diff = place === 1 ? '—' : '+' + (e.time - winner).toFixed(2);

    let badges = '';
    if (e.time <= CFG.WR + 1e-9) badges += '<span class="badge wr">МР</span>';
    if (e.time < e.seed.pb)      badges += '<span class="badge pb">PB</span>';

    return `<tr class="${cls}">
      <td class="l">${medals[i] || ''} ${place}</td>
      <td class="l">${e.seed.flag} ${e.seed.name}
        <span class="diff">${e.seed.c}</span>${badges}</td>
      <td class="m">${e.reaction.toFixed(2)}</td>
      <td class="splits m">${splitTime(e, 15).toFixed(2)}</td>
      <td class="splits m">${splitTime(e, 25).toFixed(2)}</td>
      <td class="splits m">${splitTime(e, 35).toFixed(2)}</td>
      <td class="t">${e.time.toFixed(2)}</td>
      <td class="diff">${diff}</td>
    </tr>`;
  }).join('');

  tableEl.innerHTML = `<table>
    <thead><tr>
      <th class="l">Место</th>
      <th class="l">Пловец</th>
      <th>Реакция</th>
      <th class="splits">15 м</th>
      <th class="splits">25 м</th>
      <th class="splits">35 м</th>
      <th>50 м</th>
      <th>Δ</th>
    </tr></thead>
    <tbody>${rows}</tbody>
  </table>`;
}

/* ══════════════════════════════════════════════════════════
   14. КОНФЕТТИ
   ══════════════════════════════════════════════════════════ */
let confetti = [];
let confettiRaf = 0;

function startConfetti() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  confettiEl.width  = window.innerWidth  * dpr;
  confettiEl.height = window.innerHeight * dpr;
  confettiEl.style.width  = window.innerWidth  + 'px';
  confettiEl.style.height = window.innerHeight + 'px';
  confettiCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

  const palette = ['#f6c945', '#37b6ff', '#6fe79a', '#ffffff', '#ff8787'];
  confetti = [];
  for (let i = 0; i < 160; i++) {
    confetti.push({
      x: window.innerWidth / 2 + (Math.random() - 0.5) * 200,
      y: window.innerHeight * 0.30,
      vx: (Math.random() - 0.5) * 9,
      vy: -6 - Math.random() * 9,
      w: 3 + Math.random() * 5,
      h: 2 + Math.random() * 3,
      rot: Math.random() * Math.PI * 2,
      vr: (Math.random() - 0.5) * 0.34,
      c: palette[(Math.random() * palette.length) | 0]
    });
  }
  cancelAnimationFrame(confettiRaf);
  confettiRaf = requestAnimationFrame(confettiStep);
}

function confettiStep() {
  confettiCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);
  let alive = false;

  for (const p of confetti) {
    p.vy += 0.26;
    p.x += p.vx;
    p.y += p.vy;
    p.rot += p.vr;
    if (p.y > window.innerHeight + 40) continue;
    alive = true;
    confettiCtx.save();
    confettiCtx.translate(p.x, p.y);
    confettiCtx.rotate(p.rot);
    confettiCtx.globalAlpha = 0.92;
    confettiCtx.fillStyle = p.c;
    confettiCtx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
    confettiCtx.restore();
  }

  if (alive) confettiRaf = requestAnimationFrame(confettiStep);
  else stopConfetti();
}

function stopConfetti() {
  cancelAnimationFrame(confettiRaf);
  confettiCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);
  confetti = [];
}

/* ══════════════════════════════════════════════════════════
   15. СБРОС
   ══════════════════════════════════════════════════════════ */
function reset() {
  clearTimers();
  cancelAnimationFrame(state.raf);
  stopConfetti();

  state.running = false;
  state.counting = false;
  state.entries = [];

  startBtn.disabled = false;
  startBtn.textContent = 'СТАРТ';
  statusEl.textContent = 'Готовы к старту';
  clockEl.textContent = '0.00';
  clockEl.classList.remove('go');

  flashEl.classList.remove('show');
  resultsEl.classList.remove('show');
  tableEl.innerHTML = '';
  titleEl.textContent = 'Итоговый протокол';
  resetScene();

  fxCtx.clearRect(0, 0, fx.w, fx.h);
  fx.parts = [];
  fx.ripples = [];
}

/* ══════════════════════════════════════════════════════════
   16. СОБЫТИЯ
   ══════════════════════════════════════════════════════════ */
startBtn.addEventListener('click', startRace);
resetBtn.addEventListener('click', reset);

soundBtn.addEventListener('click', () => {
  muted = !muted;
  soundBtn.textContent = muted ? '🔇' : '🔊';
  soundBtn.setAttribute('aria-pressed', String(!muted));
});

document.addEventListener('keydown', ev => {
  if (ev.code === 'Space' || ev.code === 'Enter') {
    ev.preventDefault();
    if (!state.running && !state.counting) startRace();
  } else if (ev.code === 'KeyR') {
    reset();
  } else if (ev.code === 'KeyM') {
    soundBtn.click();
  }
});

window.addEventListener('resize', () => {
  fxResize();
  if (confetti.length) {
    confettiEl.width  = window.innerWidth;
    confettiEl.height = window.innerHeight;
  }
});

/* ══════════════════════════════════════════════════════════
   17. ИНИЦИАЛИЗАЦИЯ
   ══════════════════════════════════════════════════════════ */
buildLanes();
buildCards();
resetScene();
requestAnimationFrame(() => {
  fxResize();
  if ('ResizeObserver' in window) {
    new ResizeObserver(fxResize).observe(poolEl);
  }
});

})();
</script>
</body>
</html>
